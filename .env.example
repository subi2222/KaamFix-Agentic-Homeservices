# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase Configuration (optional)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI API Key (for server-side advisor)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq text reasoning / structured responses (server-side only)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Backend deployment
ENVIRONMENT=development
FIREBASE_PROJECT_ID=your_firebase_project_id
# Local file path OR set FIREBASE_SERVICE_ACCOUNT_JSON in your host dashboard.
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/firebase-service-account.json
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KAAMFIX_DATA_DIR=
